<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- WebDAV endpoint the Supernote syncs into. Bound to localhost; Tailscale
     fronts it with TLS. Edit USERNAME and the password before loading. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maxgoodstein.webdav</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/rclone</string>
    <string>serve</string>
    <string>webdav</string>
    <string>/Users/USERNAME/pipelines/inbox/supernote</string>
    <string>--addr</string>
    <string>127.0.0.1:8085</string>
    <string>--user</string>
    <string>supernote</string>
    <string>--pass</string>
    <string>CHANGE-ME</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/pipelines/logs/webdav.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/pipelines/logs/webdav.err</string>
</dict>
</plist>
